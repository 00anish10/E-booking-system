{
	"name": "react-boilerplate",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"server": "tsx watch server/index.ts",
		"server:start": "tsx server/index.ts",
		"dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:server\"",
		"db:setup": "tsx server/seed.ts",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
		"format": "biome format ./src ./server",
		"format-fix": "biome format --write ./src ./server",
		"lint": "biome lint ./src ./server",
		"lint-fix": "biome lint --write ./src ./server"
	},
	"dependencies": {
		"@fastify/cors": "^11.4.3",
		"@fastify/jwt": "^10.2.8",
		"@headlessui/react": "^2.2.4",
		"@hookform/resolvers": "^5.1.1",
		"@hugeicons/core-free-icons": "^1.0.14",
		"@hugeicons/react": "^1.0.5",
		"@tailwindcss/vite": "^4.1.10",
		"@tanstack/react-query": "^5.90.12",
		"axios": "^1.10.0",
		"bcryptjs": "^3.0.3",
		"dotenv": "^18.0.10",
		"fastify": "^5.12.8",
		"framer-motion": "^12.19.1",
		"lucide-react": "^0.554.0",
		"pg": "^8.23.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.58.1",
		"react-router": "^7.6.2",
		"react-router-dom": "^7.9.6",
		"tailwindcss": "^4.1.10",
		"yup": "^1.6.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.5",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24.0.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"concurrently": "^10.0.7",
		"globals": "^16.2.0",
		"pino-pretty": "^13.2.0",
		"tsx": "^4.23.15",
		"typescript": "~5.8.3",
		"vite": "^6.0.0"
	},
	"exports": {
		"./biome": "./biome.json"
	}
}
